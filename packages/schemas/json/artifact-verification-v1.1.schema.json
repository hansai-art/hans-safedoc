{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacy-bridge.local/schemas/v1.1/artifact-verification-v1.1.schema.json",
  "title": "Artifact Verification v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jobId",
    "documentId",
    "artifactId",
    "format",
    "adapterId",
    "adapterVersion",
    "artifactSha256",
    "artifactSizeBytes",
    "independentParserId",
    "independentParserVersion",
    "checks",
    "verifiedOccurrences",
    "blockerCodes",
    "verifiedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "jobId": {
      "type": "string",
      "pattern": "^PB-[0-9]{8}-[0-9A-HJKMNP-TV-Z]{10}$"
    },
    "documentId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "artifactId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "format": {
      "enum": ["txt", "csv", "docx", "xlsx"]
    },
    "adapterId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "adapterVersion": {
      "const": "1.1.0"
    },
    "artifactSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifactSizeBytes": {
      "type": "integer",
      "minimum": 0
    },
    "independentParserId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "independentParserVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "containerParsed",
        "requiredPartsPresent",
        "relationshipsIntact",
        "untargetedStructurePreserved",
        "tokensAuthentic",
        "canariesAbsent",
        "activeContentAbsent"
      ],
      "properties": {
        "containerParsed": {
          "type": "boolean"
        },
        "requiredPartsPresent": {
          "type": "boolean"
        },
        "relationshipsIntact": {
          "type": "boolean"
        },
        "untargetedStructurePreserved": {
          "type": "boolean"
        },
        "tokensAuthentic": {
          "type": "boolean"
        },
        "canariesAbsent": {
          "type": "boolean"
        },
        "activeContentAbsent": {
          "type": "boolean"
        }
      }
    },
    "verifiedOccurrences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["occurrenceId", "artifactLocatorV11", "status"],
        "properties": {
          "occurrenceId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "artifactLocatorV11": {
            "$ref": "#/$defs/artifactLocatorV11"
          },
          "status": {
            "enum": ["VERIFIED", "FAILED"]
          }
        }
      },
      "maxItems": 5000000
    },
    "blockerCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "uniqueItems": true,
      "maxItems": 10000
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
