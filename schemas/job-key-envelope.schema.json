{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacy-bridge.local/schemas/job-key-envelope.schema.json",
  "title": "Client or Job Root Key Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "envelopeVersion",
    "keyKind",
    "keyId",
    "ownerId",
    "kdf",
    "cipher",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "envelopeVersion": {
      "const": "PBKEY1"
    },
    "keyKind": {
      "enum": [
        "CLIENT_ROOT_KEY",
        "JOB_ROOT_KEY",
        "BACKUP_JOB_ROOT_KEY"
      ]
    },
    "keyId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "ownerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "parentKeyId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "kdf": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "salt",
            "N",
            "r",
            "p",
            "dkLen",
            "maxmem"
          ],
          "properties": {
            "algorithm": {
              "const": "scrypt"
            },
            "salt": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "minLength": 22,
              "maxLength": 24
            },
            "N": {
              "const": 131072
            },
            "r": {
              "const": 8
            },
            "p": {
              "const": 1
            },
            "dkLen": {
              "const": 32
            },
            "maxmem": {
              "const": 268435456
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "cipher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "iv",
        "ciphertext",
        "authTag",
        "aad"
      ],
      "properties": {
        "algorithm": {
          "const": "AES-256-GCM"
        },
        "iv": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 16,
          "maxLength": 16
        },
        "ciphertext": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 43
        },
        "authTag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 22,
          "maxLength": 22
        },
        "aad": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "backupManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "backupId",
        "jobId",
        "pluginVersion",
        "createdAt",
        "jobSchemaVersion",
        "keyEnvelopeFile",
        "files",
        "packageHash"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "backupId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "jobId": {
          "type": "string",
          "pattern": "^PB-[0-9]{8}-[0-9A-HJKMNP-TV-Z]{10}$"
        },
        "pluginVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "jobSchemaVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "keyEnvelopeFile": {
          "const": "job-root-key.backup-envelope.json"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "relativePath",
              "sha256",
              "size"
            ],
            "properties": {
              "relativePath": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "not": {
                  "pattern": "(^/|^[A-Za-z]:|(^|/)\\.\\.(/|$))"
                }
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "packageHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
