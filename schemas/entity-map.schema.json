{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacy-bridge.local/schemas/entity-map.schema.json",
  "title": "Decrypted Entity Map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jobId",
    "entities",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "jobId": {
      "type": "string",
      "pattern": "^PB-[0-9]{8}-[0-9A-HJKMNP-TV-Z]{10}$"
    },
    "entities": {
      "type": "array",
      "maxItems": 1000000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entityId",
          "primaryType",
          "alternativeTypes",
          "canonicalFingerprint",
          "preferredDisplay",
          "aliases",
          "token",
          "defaultHandling",
          "createdAt"
        ],
        "properties": {
          "entityId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "primaryType": {
            "enum": [
              "TW_ID",
              "TW_ARC",
              "TW_TAX_ID",
              "TW_PASSPORT",
              "PASSPORT_CANDIDATE",
              "TW_NHI_CARD",
              "TW_MOBILE",
              "TW_LANDLINE",
              "TW_PHONE_SERVICE",
              "TW_ADDRESS",
              "TW_POSTCODE",
              "TW_PLATE",
              "TW_INVOICE",
              "TW_BANK_ACCOUNT",
              "CREDIT_CARD",
              "EMAIL",
              "IPV4",
              "URL",
              "LINE_ID",
              "SECRET",
              "PERSON",
              "ORGANIZATION",
              "PROJECT",
              "PRODUCT",
              "DEPARTMENT",
              "SYSTEM",
              "CUSTOM_TERM",
              "AMBIGUOUS_IDENTIFIER"
            ]
          },
          "alternativeTypes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "TW_ID",
                "TW_ARC",
                "TW_TAX_ID",
                "TW_PASSPORT",
                "PASSPORT_CANDIDATE",
                "TW_NHI_CARD",
                "TW_MOBILE",
                "TW_LANDLINE",
                "TW_PHONE_SERVICE",
                "TW_ADDRESS",
                "TW_POSTCODE",
                "TW_PLATE",
                "TW_INVOICE",
                "TW_BANK_ACCOUNT",
                "CREDIT_CARD",
                "EMAIL",
                "IPV4",
                "URL",
                "LINE_ID",
                "SECRET",
                "PERSON",
                "ORGANIZATION",
                "PROJECT",
                "PRODUCT",
                "DEPARTMENT",
                "SYSTEM",
                "CUSTOM_TERM",
                "AMBIGUOUS_IDENTIFIER"
              ]
            }
          },
          "canonicalFingerprint": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "minLength": 32,
            "maxLength": 64
          },
          "preferredDisplay": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 1000,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            }
          },
          "token": {
            "type": "string",
            "pattern": "^⟦PB:[A-Z][A-Z0-9_]{1,31}:[0-9A-HJKMNP-TV-Z]{16}:[0-9A-HJKMNP-TV-Z]{20}⟧$"
          },
          "riskFlags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "BLOCK_EXPORT",
                "REDACT_ONLY",
                "MANUAL_REVIEW",
                "AMBIGUOUS_TYPE",
                "LOW_CONTEXT",
                "DICTIONARY_MATCH",
                "CHECKSUM_VALIDATED",
                "RESIDUAL"
              ]
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "defaultHandling": {
            "enum": [
              "TOKENIZE",
              "REDACT",
              "BLOCK_EXPORT"
            ]
          }
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
