{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacy-bridge.local/schemas/client-profile.schema.json",
  "title": "Decrypted Client Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "clientId",
    "displayAlias",
    "operatorAlias",
    "createdAt",
    "updatedAt",
    "status",
    "jobIds",
    "policy"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "clientId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "displayAlias": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "operatorAlias": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "ARCHIVED"
      ]
    },
    "dictionaryVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "jobIds": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 100000,
      "items": {
        "type": "string",
        "pattern": "^PB-[0-9]{8}-[0-9A-HJKMNP-TV-Z]{10}$"
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "autoLockMinutes",
        "reviewDisplayThreshold",
        "locale"
      ],
      "properties": {
        "autoLockMinutes": {
          "const": 15
        },
        "reviewDisplayThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.7
        },
        "locale": {
          "enum": [
            "zh-TW",
            "en"
          ]
        }
      }
    }
  }
}
