{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacy-bridge.local/schemas/restore-manifest.schema.json",
  "title": "Result Restore Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jobId",
    "pluginVersion",
    "resultPackageHash",
    "restoredAt",
    "outputSequence",
    "restoredTokenCount",
    "unknownTokenCount",
    "files",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "jobId": {
      "type": "string",
      "pattern": "^PB-[0-9]{8}-[0-9A-HJKMNP-TV-Z]{10}$"
    },
    "pluginVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "resultPackageHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "restoredAt": {
      "type": "string",
      "format": "date-time"
    },
    "outputSequence": {
      "type": "integer",
      "minimum": 1
    },
    "restoredTokenCount": {
      "type": "integer",
      "minimum": 0
    },
    "unknownTokenCount": {
      "const": 0
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relativePath",
          "sha256",
          "size"
        ],
        "properties": {
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "not": {
              "pattern": "(^/|^[A-Za-z]:|(^|/)\\.\\.(/|$))"
            }
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "findingId"
        ],
        "properties": {
          "code": {
            "enum": [
              "HTML_ESCAPED",
              "URI_NEUTRALIZED",
              "CONTROL_REMOVED",
              "MARKDOWN_ESCAPED"
            ]
          },
          "findingId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        }
      }
    }
  }
}
