{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacy-bridge.local/schemas/lock.schema.json",
  "title": "Plaintext Operation Lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "lockId",
    "storeId",
    "clientId",
    "jobId",
    "deviceId",
    "pid",
    "processStartedAt",
    "operation",
    "acquiredAt",
    "heartbeatAt",
    "expiresAt",
    "nonce"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "lockId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "storeId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "clientId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "jobId": {
      "type": "string",
      "pattern": "^PB-[0-9]{8}-[0-9A-HJKMNP-TV-Z]{10}$"
    },
    "deviceId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "pid": {
      "type": "integer",
      "minimum": 1
    },
    "processStartedAt": {
      "type": "string",
      "format": "date-time"
    },
    "operation": {
      "type": "string",
      "enum": [
        "SCAN_PERSIST",
        "BUILD_SHADOW",
        "EXPORT",
        "IMPORT",
        "RESTORE",
        "MIGRATE",
        "BACKUP",
        "DELETE",
        "CHANGE_PASSPHRASE"
      ]
    },
    "acquiredAt": {
      "type": "string",
      "format": "date-time"
    },
    "heartbeatAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 22,
      "maxLength": 64
    }
  }
}
